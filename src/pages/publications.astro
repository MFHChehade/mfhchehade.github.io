---
import Layout from '../layouts/Layout.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { peerReviewed, preprints } from '../data/research';
---

<Layout
  title="Publications - Mohamad Chehade"
  description="Peer-reviewed publications by Mohamad Chehade on risk-aware machine learning, reliable AI, reinforcement learning, LLMs, and power systems applications."
>
  <header class="page-heading">
    <h1>Publications</h1>
    <p>
      Peer-reviewed publications in reliable machine learning, reinforcement learning,
      LLMs, optimization, and power systems applications.
    </p>
  </header>

  <section class="section">
    <h2>Conference papers</h2>
    <div class="publication-list">
      {peerReviewed.map((paper) => <PublicationEntry paper={paper} />)}
    </div>
  </section>

  {preprints.length > 0 && (
    <section class="section">
      <h2>Preprints</h2>
      <div class="publication-list">
        {preprints.map((paper) => <PublicationEntry paper={paper} />)}
      </div>
    </section>
  )}
</Layout>
