---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import NewsItem from '../components/NewsItem.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import DirectionIcon from '../components/figures/DirectionIcon.astro';
import { getPublication, getTopicPapers, topics } from '../data/research';

const researchThemes = topics.map((topic) => ({
  ...topic,
  count: getTopicPapers(topic.slug).length,
}));

const selectedPublications = ["tram", "levis", "sitalign"]
  .map((slug) => getPublication(slug))
  .filter((paper) => paper !== undefined);
---

<Layout
  title="Mohamad Chehade - Ph.D. Student"
  description="Mohamad Chehade is a Ph.D. student at The University of Texas at Austin working on risk-aware machine learning, data-driven reliability, reinforcement learning, LLMs, and power systems applications."
>
  <section class="hero">
    <div class="hero-copy">
      <h1>Mohamad <span class="name-accent">Chehade</span></h1>
      <p class="hero-statement">AI you can trust with consequential decisions.</p>
      <div class="bio-block">
        <p>
          I build AI systems that people can trust with real decisions. My research works toward
          that goal in three ways: verifying safety before deployment, adapting model behavior at
          inference time as objectives or constraints change, and evaluating methods by the
          decisions they produce. I apply these ideas to reinforcement learning, language models,
          optimization, and power systems, and develop forecasts that improve downstream decisions.
        </p>
        <p>
          I am a Ph.D. student in Electrical and Computer Engineering at
          <a href="https://www.utexas.edu/" target="_blank" rel="noopener noreferrer">The University of Texas at Austin</a>,
          advised by <a href="https://sites.utexas.edu/haozhu/" target="_blank" rel="noopener noreferrer">Prof. Hao Zhu</a>.
          I received my B.Eng. in ECE with a minor in Mathematics from the
          <a href="https://www.aub.edu.lb/" target="_blank" rel="noopener noreferrer">American University of Beirut</a>,
          where I worked with
          <a href="https://scholar.google.com/citations?user=MUMy5mcAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Prof. Rabih Jabr</a>
          and
          <a href="https://scholar.google.com/citations?user=P8z1S1YAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Prof. Sami Karaki</a>,
          and I have interned at Los Alamos National Laboratory with
          <a href="https://www.isye.gatech.edu/users/wenting-li" target="_blank" rel="noopener noreferrer">Dr. Wenting Li</a>,
          <a href="https://orcid.org/0009-0006-0600-4477" target="_blank" rel="noopener noreferrer">Dr. Brian Bell</a>,
          and
          <a href="https://scholar.google.com/citations?user=DPvklMcAAAAJ" target="_blank" rel="noopener noreferrer">Dr. Russell Bent</a>,
          and at Argonne National Laboratory with
          <a href="https://www.anl.gov/profile/feng-qiu" target="_blank" rel="noopener noreferrer">Dr. Feng Qiu</a>
          and
          <a href="https://weigao-123.github.io/" target="_blank" rel="noopener noreferrer">Dr. Wei Gao</a>.
        </p>
      </div>
      <div class="hero-social">
        <SocialLinks />
      </div>
    </div>

    <aside class="hero-media" aria-label="Research profile">
      <div class="portrait-shell">
        <img src="/profile.jpeg" alt="Mohamad Chehade" class="profile-photo" width="741" height="741" fetchpriority="high" />
      </div>
      <div class="affiliation-strip">
        <span>Ph.D. Student</span>
        <strong>The University of Texas at Austin</strong>
        <a href="mailto:chehade@utexas.edu">chehade@utexas.edu</a>
      </div>
    </aside>

  </section>

  <section class="section flow-section">
    <div class="section-heading">
      <div>
        <h2>Research directions</h2>
      </div>
      <a href="/research/">Explore all research</a>
    </div>

    <div class="theme-list">
      {researchThemes.map((theme) => (
        <a class="theme-row" href={`/research/${theme.slug}/`} data-reveal>
          <span class="theme-icon"><DirectionIcon name={theme.slug} /></span>
          <div class="theme-body">
            <h3>{theme.shortTitle}</h3>
            <p>{theme.summary}</p>
          </div>
          <span class="theme-count">{theme.count} {theme.count === 1 ? "paper" : "papers"}</span>
          <span class="theme-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <h2>Selected publications</h2>
      </div>
      <a href="/publications/">View all publications</a>
    </div>

    <div class="publication-list">
      {selectedPublications.map((paper) => <PublicationEntry paper={paper} />)}
    </div>
  </section>

  <section class="section lower-grid">
    <div>
      <div class="section-heading">
        <div>
          <h2>Recent activity</h2>
        </div>
      </div>

      <div class="news-list">
        <NewsItem
          date="Oct 2026"
          content='I presented the tutorial <a href="https://github.com/AlaaSelim-sudo/GridGuard-Agentic-AI-Tutorials" target="_blank" rel="noopener noreferrer"><strong>Agentic AI for Grid Operators in Active Distribution Networks within a Multi-Agent Framework</strong></a> with <a href="https://www.gear.mit.edu/alaa-selim" target="_blank" rel="noopener noreferrer">Dr. Alaa Selim</a> (MIT) and Dr. Mahmoud Abdelaal (ABB) at <strong>IEEE SmartGridComm 2026</strong> in College Station, Texas, on <strong>Monday, October 26</strong>.'
        />
        <NewsItem
          date="Sep 2026"
          content='<a href="https://doi.org/10.48550/arXiv.2408.08812" target="_blank" rel="noopener noreferrer"><strong>Test-Time Risk Adaptation with Mixture of Agents</strong></a> accepted to <strong>NeurIPS 2026</strong>.'
        />
        <NewsItem
          date="Aug 2026"
          content='Awarded <strong>third place</strong> at the <a href="https://event.asme.org/IDETC-CIE-2026/Program/Student-Hackathon" target="_blank" rel="noopener noreferrer"><strong>ASME CIE 2026 Student Hackathon</strong></a>, a competition focused on AI for engineering design and manufacturing, organized by the American Society of Mechanical Engineers (ASME) and its Computer &amp; Information in Engineering (CIE) Division.'
        />
        <NewsItem
          date="Mar 2026"
          content='Two papers accepted to the <strong>2026 IEEE Power &amp; Energy Society General Meeting (PESGM)</strong>: <a href="https://arxiv.org/abs/2602.15350" target="_blank" rel="noopener noreferrer"><strong>Fine-Tuning LLMs to Generate Economical and Reliable Actions for the Power Grid</strong></a> and <a href="https://arxiv.org/abs/2603.08654" target="_blank" rel="noopener noreferrer"><strong>Carbon-aware Market Participation for Building Energy Management Systems</strong></a>.'
        />
        <NewsItem
          date="Aug 2025"
          content='<a href="/Neo-Grid.pdf"><strong>NEO-Grid</strong></a> accepted to <strong>HICSS 2026</strong>.'
        />
        <NewsItem
          date="May 2025"
          content='Two papers accepted to <strong>ICML 2025</strong>: <a href="https://doi.org/10.48550/arXiv.2408.08824" target="_blank" rel="noopener noreferrer"><strong>LEVIS: Large Exact Verifiable Input Spaces for Neural Networks</strong></a> and <a href="https://arxiv.org/abs/2505.23729" target="_blank" rel="noopener noreferrer"><strong>Bounded Rationality for LLMs: Satisficing Alignment at Inference-Time (SITAlign)</strong></a>.'
        />
        <NewsItem
          date="Oct 2024"
          content='Awarded Best Graduate Presentation Award at <strong>NAPS 2024</strong> for <a href="https://ieeexplore.ieee.org/abstract/document/10741791" target="_blank" rel="noopener noreferrer"><strong>Should We Use Model-Free or Model-Based Control? A Case Study of Battery Control</strong></a>.'
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 240px);
    gap: 1.4rem 2.4rem;
    align-items: center;
    position: relative;
    padding: 1.5rem 0 1rem;
  }

  .hero-copy {
    max-width: 760px;
  }

  .name-accent {
    color: inherit;
  }

  .hero-statement {
    max-width: 640px;
    color: var(--charcoal);
    font-family: var(--sans);
    font-size: clamp(1rem, 1.45vw, 1.12rem);
    line-height: 1.32;
    font-weight: 500;
    margin: 1rem 0 1.2rem;
  }

  .bio-block {
    display: grid;
    gap: 0.7rem;
    max-width: 66ch;
    margin-bottom: 1.25rem;
    color: var(--charcoal);
    font-size: 1rem;
  }

  .hero-social {
    margin-top: 1.1rem;
  }

  .hero-media {
    display: grid;
    gap: 0.75rem;
    align-self: start;
    justify-self: end;
    width: min(100%, 240px);
  }

  .portrait-shell {
    position: relative;
    padding: 0.55rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 300ms ease;
  }

  .portrait-shell:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .profile-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 13px;
  }

  .affiliation-strip {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
  }

  .affiliation-strip span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .affiliation-strip strong {
    color: var(--charcoal);
  }

  .theme-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .theme-row {
    position: relative;
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.4rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }

  .theme-row > * {
    position: relative;
    z-index: 1;
  }


  .theme-icon {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color 200ms ease;
  }

  .theme-row:hover .theme-icon {
    border-color: var(--accent-line);
  }

  .theme-body h3 {
    font-family: var(--sans);
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    transition: color 200ms ease;
  }

  .theme-row:hover .theme-body h3 {
    color: var(--burnt);
  }

  .theme-body p {
    color: var(--muted);
    margin: 0;
    font-size: 0.97rem;
    max-width: 52ch;
  }

  .theme-count {
    color: var(--muted);
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .theme-arrow {
    display: inline-grid;
    place-items: center;
    color: var(--muted);
    transition: color 220ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-row:hover .theme-arrow {
    color: var(--burnt);
    transform: translateX(5px);
  }

  @media (max-width: 720px) {
    .theme-row {
      grid-template-columns: 3.4rem minmax(0, 1fr) auto;
      gap: 0.4rem 1rem;
    }

    .theme-icon {
      grid-column: 1;
      grid-row: 1 / 3;
      align-self: start;
    }

    .theme-count {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
    }

    .theme-arrow {
      grid-column: 3;
      grid-row: 1 / 3;
    }

    .theme-body h3 {
      font-size: 1.12rem;
    }
  }

  .lower-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: start;
  }

  @media (max-width: 820px) {
    .hero,
    .lower-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 1.6rem;
    }

    .hero-media {
      justify-self: center;
      width: min(100%, 340px);
    }
  }

  @media (max-width: 520px) {
    .hero-statement {
      font-size: 1.18rem;
    }

    .bio-block {
      font-size: 1rem;
    }
  }
</style>
