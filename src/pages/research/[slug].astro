---
import Layout from '../../layouts/Layout.astro';
import PaperFigure from '../../components/figures/PaperFigure.astro';
import PaperThumb from '../../components/figures/PaperThumb.astro';
import DirectionIcon from '../../components/figures/DirectionIcon.astro';
import { withTex } from '../../components/figures/tex';
import { getPublication, getTopicPapers, topics } from '../../data/research';

export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const papers = getTopicPapers(topic.slug);
const featured = getPublication(topic.featured);
---

<Layout
  title={`${topic.title} - Mohamad Chehade`}
  description={`${topic.title}: ${topic.summary}`}
>
  <header class="topic-hero">
    <div class="topic-copy">
      <a class="back-link" href="/research/">Research</a>
      <div class="topic-title">
        <span class="topic-icon"><DirectionIcon name={topic.slug} /></span>
        <h1>{topic.title}</h1>
      </div>
      <p class="lead">{topic.summary}</p>
      <p>{topic.focus}</p>
    </div>
  </header>

  <figure class="figure-frame topic-figure">
    <PaperFigure name={topic.featured} />
    <figcaption>
      <strong><a href={`/publications/${topic.featured}/`}>{featured?.shortTitle}</a> ({featured?.shortVenue} {featured?.year}).</strong>
      {" "}<span set:html={withTex(featured?.figureCaption ?? "")} />
    </figcaption>
  </figure>

  <section class="section">
    <div class="section-heading">
      <div>
        <h2>Papers in this direction</h2>
      </div>
      <p>{papers.length} papers connected to this topic.</p>
    </div>

    <div class="topic-paper-grid">
      {papers.map((paper) => (
        <article class="topic-paper">
          <a class="pub-thumb" href={`/publications/${paper.slug}/`} aria-label={`Open ${paper.shortTitle}`}>
            <PaperThumb name={paper.slug} />
          </a>
          <div>
            <p class="paper-venue">{paper.shortVenue} {paper.year}</p>
            <h3><a href={`/publications/${paper.slug}/`}>{paper.title}</a></h3>
            <p>{paper.summary}</p>
            <div class="link-row">
              <a href={`/publications/${paper.slug}/`}>details</a>
              {paper.links.map((link) => {
                const isExternal = link.href.startsWith("http");
                return (
                  <a
                    href={link.href}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                );
              })}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .topic-hero {
    padding: 3.2rem 0 1.6rem;
  }

  .topic-copy {
    max-width: 780px;
  }

  .topic-title {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 0.9rem;
  }

  .topic-icon {
    flex: none;
    width: 4.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  @media (max-width: 520px) {
    .topic-icon {
      width: 3.4rem;
    }
  }

  .topic-copy p {
    color: var(--muted);
  }

  .topic-copy .lead {
    color: var(--charcoal);
  }

  .back-link {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1.1rem;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
  }

  .back-link::before {
    content: "←";
  }

  .back-link:hover {
    color: var(--burnt);
  }

  .topic-figure {
    max-width: 920px;
  }

  .topic-figure figcaption a {
    color: inherit;
    text-decoration-color: var(--accent-line);
  }

  .topic-paper-grid {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .topic-paper {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line);
  }

  .topic-paper h3 {
    margin-bottom: 0.45rem;
    font-size: 1.12rem;
    line-height: 1.35;
  }

  .topic-paper h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .topic-paper h3 a:hover {
    color: var(--burnt);
  }

  .topic-paper p {
    color: var(--muted);
    margin: 0;
  }

  .topic-paper .paper-venue {
    margin-bottom: 0.25rem;
    color: var(--burnt);
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .topic-paper {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .topic-paper .pub-thumb {
      max-width: 320px;
    }
  }

  @media (max-width: 820px) {
    .topic-hero {
      padding-top: 2rem;
    }
  }
</style>
