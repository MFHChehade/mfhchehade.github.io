---
import Layout from '../../layouts/Layout.astro';
import PaperFigure from '../../components/figures/PaperFigure.astro';
import { withTex } from '../../components/figures/tex';
import { publications, topics } from '../../data/research';

export function getStaticPaths() {
  return publications.map((paper) => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const relatedTopics = paper.topics
  .map((slug) => topics.find((topic) => topic.slug === slug))
  .filter(Boolean);

const siteOrigin = Astro.site?.origin ?? "https://mohamadchehade.com";
const pageURL = new URL(Astro.url.pathname, siteOrigin).toString();

const parseAuthors = (raw: string) =>
  raw
    .split(/,\s*(?:&|and)\s*|\s*,\s*/)
    .map((name) => name.replace(/\.$/, "").trim())
    .filter(Boolean)
    .map((name) => {
      const parts = name.split(/\s+/);
      const given = parts[0];
      const family = parts.slice(1).join(" ");
      return { "@type": "Person", givenName: given, familyName: family, name };
    });

const firstExternalLink = paper.links.find((l) => l.href.startsWith("http"));
const isPeerReviewed = paper.type === "peer-reviewed";

const scholarlyArticleJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": isPeerReviewed ? "ScholarlyArticle" : "Article",
  headline: paper.title,
  name: paper.shortTitle,
  description: paper.summary,
  url: pageURL,
  datePublished: `${paper.year}-01-01`,
  inLanguage: "en",
  author: parseAuthors(paper.authors),
  keywords: paper.topics
    .map((slug) => topics.find((t) => t.slug === slug)?.shortTitle ?? slug)
    .join(", "),
  isAccessibleForFree: true,
  isPartOf: isPeerReviewed
    ? {
        "@type": "PublicationIssue",
        issueNumber: paper.year,
        datePublished: `${paper.year}-01-01`,
        isPartOf: {
          "@type": "Periodical",
          name: paper.venue,
        },
      }
    : undefined,
  identifier: firstExternalLink?.href,
  sameAs: paper.links.filter((l) => l.href.startsWith("http")).map((l) => l.href),
};
---

<Layout
  title={`${paper.shortTitle} - Mohamad Chehade`}
  description={`${paper.title}: ${paper.summary}`}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(scholarlyArticleJsonLd)} />
  <article class="paper-page">
    <header class="paper-hero">
      <div class="paper-copy">
        <a class="back-link" href="/publications">Publications</a>
        <h1>{paper.title}</h1>
        <p class="authors">{paper.authors}</p>
        <p class="venue">{paper.venue}</p>
        <p class="lead">{paper.summary}</p>
        <div class="link-row">
          {paper.links.map((link) => {
            const isExternal = link.href.startsWith("http");
            return (
              <a
                href={link.href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            );
          })}
        </div>
      </div>

    </header>

    <figure class="figure-frame paper-figure">
      <PaperFigure name={paper.slug} />
      {paper.figureCaption && (
        <figcaption>
          <strong>Figure.</strong> <span set:html={withTex(paper.figureCaption)} />
        </figcaption>
      )}
    </figure>

    <section class="section paper-grid">
      <div class="paper-panel">
        <h2>What this paper adds</h2>
        <ul>
          {paper.contribution.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <aside class="paper-panel">
        <h2>Research directions</h2>
        <div class="topic-list">
          {relatedTopics.map((topic) => (
            <a href={`/research/${topic.slug}`}>
              <strong>{topic.shortTitle}</strong>
            </a>
          ))}
        </div>
      </aside>
    </section>
  </article>
</Layout>

<style>
  .paper-page {
    display: grid;
  }

  .paper-hero {
    padding: 3.2rem 0 1.6rem;
  }

  .paper-copy {
    max-width: 780px;
  }

  .paper-copy h1 {
    margin: 0.7rem 0 0.75rem;
  }

  .back-link {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
  }

  .back-link::before {
    content: "←";
  }

  .back-link:hover {
    color: var(--burnt);
  }

  .paper-figure {
    max-width: 920px;
  }

  .paper-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 0.45fr);
    gap: 2.5rem;
  }

  .paper-panel h2 {
    font-size: 1.2rem;
  }

  .paper-panel h2 {
    margin-bottom: 0.6rem;
  }

  .paper-panel ul {
    margin-bottom: 0;
  }

  .topic-list {
    display: grid;
    gap: 0.35rem;
  }

  .topic-list a {
    color: var(--blue);
  }

  .topic-list a strong {
    font-weight: 400;
  }

  .topic-list a:hover {
    color: var(--burnt);
  }

  @media (max-width: 820px) {
    .paper-grid {
      grid-template-columns: 1fr;
    }

    .paper-hero {
      padding-top: 2rem;
    }
  }
</style>
