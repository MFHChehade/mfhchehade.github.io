---
import Layout from '../../layouts/Layout.astro';
import PaperFigure from '../../components/figures/PaperFigure.astro';
import { withTex } from '../../components/figures/tex';
import { publications, toBibtex, topics, untex } from '../../data/research';

export function getStaticPaths() {
  return publications.map((paper) => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const relatedTopics = paper.topics
  .map((slug) => topics.find((topic) => topic.slug === slug))
  .filter(Boolean);

const siteOrigin = Astro.site?.origin ?? "https://www.mohamadchehade.com";
const pageURL = new URL(Astro.url.pathname, siteOrigin).toString();
const cite = paper.cite;
const bibtex = toBibtex(paper);
const [firstPage, lastPage] = (cite.pages ?? "").split("--");

// "Last, First" -> schema.org Person.
const people = cite.authors.map((author) => {
  const [familyName, givenName] = author.split(/,\s*/);
  return { "@type": "Person", givenName, familyName, name: `${givenName} ${familyName}` };
});

const externalLinks = paper.links.filter((l) => l.href.startsWith("http")).map((l) => l.href);

const scholarlyArticleJsonLd = {
  "@context": "https://schema.org",
  "@type": paper.type === "peer-reviewed" ? "ScholarlyArticle" : "Article",
  headline: paper.title,
  name: paper.title,
  alternativeHeadline: paper.shortTitle,
  description: paper.summary,
  url: pageURL,
  datePublished: paper.year,
  inLanguage: "en",
  author: people,
  keywords: paper.topics
    .map((slug) => topics.find((t) => t.slug === slug)?.shortTitle ?? slug)
    .join(", "),
  isAccessibleForFree: true,
  identifier: cite.doi ? `https://doi.org/${cite.doi}` : externalLinks[0],
  sameAs: externalLinks,
};
---

<Layout
  title={`${paper.title} - Mohamad Chehade`}
  description={`${paper.title}: ${paper.summary}`}
  ogType="article"
>
  <Fragment slot="head">
    {/* Google Scholar's inclusion guidelines read these tags. */}
    <meta name="citation_title" content={paper.title} />
    {cite.authors.map((author) => <meta name="citation_author" content={author} />)}
    <meta name="citation_publication_date" content={paper.year} />
    <meta name="citation_conference_title" content={untex(cite.booktitle)} />
    {cite.volume && <meta name="citation_volume" content={cite.volume} />}
    {firstPage && <meta name="citation_firstpage" content={firstPage} />}
    {lastPage && <meta name="citation_lastpage" content={lastPage} />}
    {cite.publisher && <meta name="citation_publisher" content={cite.publisher} />}
    {cite.doi && <meta name="citation_doi" content={cite.doi} />}
    {cite.pdf && <meta name="citation_pdf_url" content={new URL(cite.pdf, siteOrigin).toString()} />}
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(scholarlyArticleJsonLd)} />
  <article class="paper-page">
    <header class="paper-hero">
      <div class="paper-copy">
        <a class="back-link" href="/publications/">Publications</a>
        <h1>{paper.title}</h1>
        <p class="authors">{paper.authors}</p>
        <p class="venue">{paper.venue}</p>
        <p class="lead">{paper.summary}</p>
        <div class="link-row">
          {paper.links.map((link) => {
            const isExternal = link.href.startsWith("http");
            return (
              <a
                href={link.href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            );
          })}
          <a href="#cite">BibTeX</a>
        </div>
      </div>

    </header>

    <figure class="figure-frame paper-figure">
      <PaperFigure name={paper.slug} />
      {paper.figureCaption && (
        <figcaption>
          <strong>Figure.</strong> <span set:html={withTex(paper.figureCaption)} />
        </figcaption>
      )}
    </figure>

    <section class="section paper-grid">
      <div class="paper-panel">
        <h2>What this paper adds</h2>
        <ul>
          {paper.contribution.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <aside class="paper-panel">
        <h2>Research directions</h2>
        <div class="topic-list">
          {relatedTopics.map((topic) => (
            <a href={`/research/${topic.slug}/`}>
              <strong>{topic.shortTitle}</strong>
            </a>
          ))}
        </div>
      </aside>
    </section>

    <section class="section cite" id="cite">
      <div class="cite-head">
        <h2>Cite</h2>
        <button class="copy-bib" type="button" data-copy="bibtex">Copy BibTeX</button>
      </div>
      <pre class="bibtex"><code id="bibtex">{bibtex}</code></pre>
    </section>
  </article>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((button) => {
    const code = document.getElementById(button.dataset.copy ?? "");
    if (!code) return;
    const label = button.textContent;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        button.textContent = "Copied";
      } catch {
        // No clipboard access: select the entry so it can be copied by hand.
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        button.textContent = "Selected";
      }
      setTimeout(() => (button.textContent = label), 2200);
    });
  });
</script>

<style>
  .paper-page {
    display: grid;
  }

  .paper-hero {
    padding: 3.2rem 0 1.6rem;
  }

  .paper-copy {
    max-width: 780px;
  }

  .paper-copy h1 {
    margin: 0.7rem 0 0.75rem;
  }

  .back-link {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
  }

  .back-link::before {
    content: "←";
  }

  .back-link:hover {
    color: var(--burnt);
  }

  .paper-figure {
    max-width: 920px;
  }

  .paper-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 0.45fr);
    gap: 2.5rem;
  }

  .paper-panel h2 {
    font-size: 1.2rem;
  }

  .paper-panel h2 {
    margin-bottom: 0.6rem;
  }

  .paper-panel ul {
    margin-bottom: 0;
  }

  .topic-list {
    display: grid;
    gap: 0.35rem;
  }

  .topic-list a {
    color: var(--blue);
  }

  .topic-list a strong {
    font-weight: 400;
  }

  .topic-list a:hover {
    color: var(--burnt);
  }

  .cite {
    min-width: 0;
    scroll-margin-top: 5rem;
  }

  .cite-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .cite-head h2 {
    margin: 0;
    font-size: 1.2rem;
  }

  .copy-bib {
    color: var(--blue);
    background: var(--blue-soft);
    border: 1px solid var(--blue-line);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
  }

  .copy-bib:hover {
    color: var(--on-accent);
    background: var(--burnt);
    border-color: var(--burnt);
  }

  .bibtex {
    margin: 0;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    color: var(--charcoal);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: ui-monospace, "Cascadia Mono", Consolas, Menlo, monospace;
    font-size: 0.78rem;
    line-height: 1.55;
    tab-size: 2;
  }

  @media (max-width: 820px) {
    .paper-grid {
      grid-template-columns: 1fr;
    }

    .paper-hero {
      padding-top: 2rem;
    }
  }
</style>
