---
import Layout from '../layouts/Layout.astro';
import PaperFigure from '../components/figures/PaperFigure.astro';
import DirectionIcon from '../components/figures/DirectionIcon.astro';
import { withTex } from '../components/figures/tex';
import { getPublication, getTopicPapers, topics } from '../data/research';

// What each direction contributes to the one question, in the page's own words.
const roles: Record<string, string> = {
  'risk-aware-learning': 'Sets the objective',
  'data-driven-reliability': 'Provides the guarantees',
  'llm-decision-systems': 'Tests it on language-driven control',
  'power-systems-applications': 'Grounds it in a reliability-critical domain',
};
---

<Layout
  title="Research - Mohamad Chehade"
  description="Research areas for Mohamad Chehade, including risk-aware machine learning, data-driven reliability, reinforcement learning, LLMs, and power systems applications."
>
  <header class="page-heading research-intro">
    <h1>Research</h1>
    <p class="question-label">One question behind all of it</p>
    <p class="research-question">
      How can learning systems make decisions under uncertainty that are
      <em>risk-aware</em> and <em>verifiable</em>?
    </p>
  </header>

  <nav class="direction-map" aria-label="Research directions">
    {topics.map((topic, i) => (
      <a class="map-card" href={`#${topic.slug}`}>
        <span class="map-icon"><DirectionIcon name={topic.slug} /></span>
        <span class="map-text">
          <span class="map-index">0{i + 1}</span>
          <span class="map-title">{topic.shortTitle}</span>
          <span class="map-role">{roles[topic.slug]}</span>
        </span>
      </a>
    ))}
  </nav>
  <p class="map-note">Most papers advance more than one direction, so they appear under each one they serve.</p>

  {topics.map((topic) => {
    const topicPapers = getTopicPapers(topic.slug);
    const featured = getPublication(topic.featured);
    return (
      <section class="direction" id={topic.slug}>
        <h2><a href={`/research/${topic.slug}/`}>{topic.title}</a></h2>
        <p>{topic.summary} {topic.focus}</p>

        <figure class="figure-frame">
          <a href={`/publications/${topic.featured}/`} aria-label={`Open ${featured?.shortTitle}`}>
            <PaperFigure name={topic.featured} />
          </a>
          <figcaption>
            <strong><a href={`/publications/${topic.featured}/`}>{featured?.shortTitle}</a> ({featured?.shortVenue} {featured?.year}).</strong>
            {" "}<span set:html={withTex(featured?.figureCaption ?? "")} />
          </figcaption>
        </figure>

        <p class="direction-papers">
          Papers:{" "}
          {topicPapers.map((paper, i) => (
            <>
              <a href={`/publications/${paper.slug}/`}>{paper.shortTitle}</a>{i < topicPapers.length - 1 ? ", " : ""}
            </>
          ))}
          {" · "}
          <a href={`/research/${topic.slug}/`}>more on this direction</a>
        </p>
      </section>
    );
  })}
</Layout>

<style>
  .research-intro {
    padding-bottom: 1.2rem;
  }

  .question-label {
    margin: 0 0 0.6rem;
    color: var(--burnt);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-heading .research-question {
    margin: 0;
    padding-left: 1.1rem;
    border-left: 4px solid var(--burnt);
    color: var(--ink);
    font-size: clamp(1.45rem, 1.1rem + 1.4vw, 2.05rem);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .research-question em {
    font-style: normal;
    color: var(--burnt);
    white-space: nowrap;
  }

  .direction-map {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .map-card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.7rem;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }

  .map-card:hover,
  .map-card:focus-visible {
    border-color: var(--accent-line);
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
  }

  .map-icon {
    display: block;
    width: 3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .map-text {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    min-width: 0;
  }

  .map-index {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .map-title {
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
    transition: color 200ms ease;
  }

  .map-card:hover .map-title,
  .map-card:focus-visible .map-title {
    color: var(--burnt);
  }

  .map-role {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .map-note {
    margin: 0.9rem 0 1.4rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (max-width: 760px) {
    .direction-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-card {
      transition: none;
    }

    .map-card:hover,
    .map-card:focus-visible {
      transform: none;
    }
  }

  .direction {
    display: grid;
    gap: 1rem;
    padding: 2.4rem 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 5rem;
  }

  .direction h2 {
    margin: 0;
  }

  .direction h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .direction h2 a:hover {
    color: var(--burnt);
  }

  .direction p {
    margin: 0;
    color: var(--charcoal);
  }

  .direction figcaption a {
    color: inherit;
    text-decoration-color: var(--line-strong);
  }

  .direction-papers {
    font-size: 0.95rem;
  }

  .direction-papers a {
    color: var(--blue);
  }

  @media (max-width: 520px) {
    .direction {
      padding: 1.8rem 0;
    }

    .figure-frame {
      padding: 0.6rem;
    }
  }
</style>
