---
// One publication in a list: a small-size figure thumbnail, then title,
// authors (own name in bold), venue, and plain links.
import PaperThumb from "./figures/PaperThumb.astro";
import type { Publication } from "../data/research";

interface Props {
  paper: Publication;
}

const { paper } = Astro.props;
const SELF = "M. Chehade";
const [before, ...rest] = paper.authors.split(SELF);
const after = rest.join(SELF);
const hasSelf = rest.length > 0;
---

<article class="publication-entry with-thumb">
  <a class="pub-thumb" href={`/publications/${paper.slug}/`} aria-label={`Open ${paper.shortTitle}`}>
    <PaperThumb name={paper.slug} />
  </a>
  <div class="pub-text">
    <h3><a href={`/publications/${paper.slug}/`}>{paper.title}</a></h3>
    <p class="authors">
      {hasSelf ? (
        <>{before}<strong>{SELF}</strong>{after}</>
      ) : (
        paper.authors
      )}
    </p>
    <p class="venue">{paper.venue}</p>
    <div class="link-row">
      {paper.links.map((link) => {
        const isExternal = link.href.startsWith("http");
        return (
          <a
            href={link.href}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        );
      })}
      <a href={`/publications/${paper.slug}/`}>details</a>
      <a href={`/publications/${paper.slug}/#cite`}>BibTeX</a>
    </div>
  </div>
</article>

<style>
  .with-thumb {
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
  }

  .authors strong {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .with-thumb {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .pub-thumb {
      max-width: 320px;
    }
  }
</style>
