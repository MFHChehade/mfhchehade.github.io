---
// One publication in a list: title, authors (own name in bold), venue, and
// plain links. Figures are shown full size on each paper's own page; at
// thumbnail size their labels are too small to read.
import type { Publication } from "../data/research";

interface Props {
  paper: Publication;
}

const { paper } = Astro.props;
const SELF = "M. Chehade";
const [before, ...rest] = paper.authors.split(SELF);
const after = rest.join(SELF);
const hasSelf = rest.length > 0;
---

<article class="publication-entry">
  <h3><a href={`/publications/${paper.slug}`}>{paper.title}</a></h3>
  <p class="authors">
    {hasSelf ? (
      <>{before}<strong>{SELF}</strong>{after}</>
    ) : (
      paper.authors
    )}
  </p>
  <p class="venue">{paper.venue}</p>
  <div class="link-row">
    {paper.links.map((link) => {
      const isExternal = link.href.startsWith("http");
      return (
        <a
          href={link.href}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
        >
          {link.label}
        </a>
      );
    })}
    <a href={`/publications/${paper.slug}`}>details</a>
  </div>
</article>

<style>
  .authors strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
