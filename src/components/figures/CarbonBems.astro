---
// Carbon-aware BEMS (PESGM 2026), Fig. 3 of the paper redrawn: daily energy
// cost vs. carbon emissions for four carbon-tax levels and the unmanaged
// baseline. Point positions were read off the paper's figure image
// (calibrated to its axes; accurate to about 0.02 $/day and 0.015 t/day).
const points = [
  { tax: "$0/t", cost: 652.73, co2: 20.47, label: { dx: 12, dy: 5, anchor: "start" } },
  { tax: "$10/t", cost: 659.04, co2: 16.62, label: { dx: 9, dy: -9, anchor: "start" } },
  { tax: "$20/t", cost: 660.29, co2: 16.21, label: { dx: 0, dy: 22, anchor: "middle" } },
  { tax: "$30/t", cost: 662.61, co2: 16.12, label: { dx: 11, dy: 5, anchor: "start" } },
];
const baseline = { cost: 676.78, co2: 20.3 };

const x0 = 76;
const x1 = 624;
const y0 = 252; // bottom of the plot area
const y1 = 16; // top
const xMin = 650;
const xMax = 680;
const yMin = 15;
const yMax = 21;
const sx = (v: number) => x0 + ((v - xMin) / (xMax - xMin)) * (x1 - x0);
const sy = (v: number) => y0 - ((v - yMin) / (yMax - yMin)) * (y0 - y1);
const xTicks = [650, 655, 660, 665, 670, 675, 680];
const yTicks = [15, 16, 17, 18, 19, 20, 21];
const curve = points.map((p) => `${sx(p.cost).toFixed(1)},${sy(p.co2).toFixed(1)}`).join(" ");
---

<svg
  class="fig"
  viewBox="0 0 640 312"
  role="img"
  aria-label="Scatter plot from the carbon-aware EMS paper: daily energy cost against daily carbon emissions. With no carbon tax the EMS costs about 652.7 dollars per day and emits 20.5 tonnes. Taxes of 10, 20 and 30 dollars per tonne cut emissions to about 16.6, 16.2 and 16.1 tonnes per day while cost rises to 659.0, 660.3 and 662.6 dollars. The unmanaged baseline costs 676.8 dollars and emits 20.3 tonnes per day."
>
  {yTicks.map((t) => (
    <g>
      <line x1={x0} x2={x1} y1={sy(t)} y2={sy(t)} class="grid"></line>
      {t > yMin && <text x={x0 - 8} y={sy(t) + 4} class="t-sm t-muted t-num" text-anchor="end">{t}</text>}
    </g>
  ))}
  {xTicks.map((t) => (
    <g>
      <line x1={sx(t)} x2={sx(t)} y1={y1} y2={y0} class="grid"></line>
      <text x={sx(t)} y={y0 + 18} class="t-sm t-muted t-num" text-anchor="middle">{t}</text>
    </g>
  ))}
  <line x1={x0} x2={x1} y1={y0} y2={y0} class="ln" stroke-width="1"></line>
  <line x1={x0} x2={x0} y1={y1} y2={y0} class="ln" stroke-width="1"></line>

  <!-- carbon-tax dispatches, in order of increasing tax -->
  <polyline points={curve} class="s-blue" fill="none" stroke-width="1.4"></polyline>
  {points.map((p) => (
    <g>
      <circle cx={sx(p.cost)} cy={sy(p.co2)} r="5.5" class="f-blue" stroke="var(--f-bg)" stroke-width="1.5">
        <title>{`Carbon tax ${p.tax}: $${p.cost.toFixed(1)}/day, ${p.co2.toFixed(2)} t CO2/day`}</title>
      </circle>
      <text x={sx(p.cost) + p.label.dx} y={sy(p.co2) + p.label.dy} class="t-sm" text-anchor={p.label.anchor}>{p.tax}</text>
    </g>
  ))}

  <!-- unmanaged baseline: imports follow demand, no storage or flexibility -->
  <circle cx={sx(baseline.cost)} cy={sy(baseline.co2)} r="5.5" class="f-bg" stroke="var(--f-ink)" stroke-width="1.6">
    <title>{`Baseline (no EMS): $${baseline.cost.toFixed(1)}/day, ${baseline.co2.toFixed(2)} t CO2/day`}</title>
  </circle>
  <text x={sx(baseline.cost)} y={sy(baseline.co2) + 22} class="t-sm" text-anchor="middle">baseline (no EMS)</text>

  <text x={(x0 + x1) / 2} y={y0 + 46} class="t-sm" text-anchor="middle">Energy cost ($/day)</text>
  <text x="0" y="0" class="t-sm" text-anchor="middle" transform={`translate(18 ${(y0 + y1) / 2}) rotate(-90)`}>Carbon emissions (t CO₂/day)</text>
</svg>
