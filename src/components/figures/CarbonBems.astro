---
// Carbon-aware BEMS (PESGM 2026): the CAEMS loop described in the paper.
// PJM day-ahead and real-time signals feed a Transformer forecaster, and an
// MPC-wrapped MILP co-optimizes grid imports, storage, and flexible demand.
const boxes = [
  { x: 176, w: 132, eyebrow: "FORECAST", title: "Transformer", lines: ["next 24 h of price", "and carbon intensity"] },
  { x: 334, w: 148, eyebrow: "CARBON-AWARE EMS", title: "MPC + MILP", lines: ["min energy cost", "+ carbon price × emissions"] },
];
---

<svg
  class="fig"
  viewBox="0 26 640 246"
  role="img"
  aria-label="Carbon-aware EMS: PJM day-ahead and real-time prices and marginal carbon intensities feed a Transformer forecaster; a model predictive controller solves a MILP that minimizes energy cost plus a carbon price times emissions, dispatching grid imports, battery storage and flexible demand. On PJM data a modest carbon price cuts emissions by 22.5 percent for a 1.7 percent cost increase."
>
  <!-- Market signals -->
  <rect class="panel" x="0" y="34" width="150" height="150" rx="9"></rect>
  <text x="14" y="56" class="t-eyebrow">PJM MARKETS</text>
  <text x="14" y="76" class="t-xs t-muted">day-ahead + real-time</text>
  <line x1="14" y1="104" x2="32" y2="104" class="s-blue" stroke-width="3" stroke-linecap="round"></line>
  <text x="40" y="108" class="t-sm">price</text>
  <text x="80" y="108" class="math" font-size="14">p<tspan dy="3" font-size="10">t</tspan></text>
  <line x1="14" y1="134" x2="32" y2="134" class="s-green" stroke-width="3" stroke-linecap="round"></line>
  <text x="40" y="138" class="t-sm">carbon</text>
  <text x="90" y="138" class="math" font-size="14">c<tspan dy="3" font-size="10">t</tspan></text>
  <text x="14" y="168" class="t-xs t-muted">marginal intensity, hourly</text>

  {boxes.map((b) => (
    <g>
      <rect class="card" x={b.x} y="34" width={b.w} height="150" rx="9"></rect>
      <text x={b.x + 14} y="56" class="t-eyebrow">{b.eyebrow}</text>
      <text x={b.x + 14} y="84" class="t-b t-lg">{b.title}</text>
      {b.lines.map((line, i) => (
        <text x={b.x + 14} y={110 + i * 17} class="t-xs t-muted">{line}</text>
      ))}
    </g>
  ))}

  <!-- Building and its three levers -->
  <rect x="508" y="34" width="132" height="150" rx="9" class="w-orange s-orange" stroke-width="1.4"></rect>
  <text x="522" y="56" class="t-eyebrow">BUILDING</text>
  <g class="ln" stroke-width="1.5">
    <line x1="522" y1="86" x2="536" y2="86"></line>
  </g>
  <polygon points="540,86 533,82 533,90" class="head"></polygon>
  <text x="546" y="90" class="t-sm">grid imports</text>
  <rect x="522" y="112" width="15" height="9" rx="1.5" class="ln" stroke-width="1.4"></rect>
  <rect x="537.5" y="114.5" width="2.5" height="4" class="head"></rect>
  <text x="546" y="121" class="t-sm">battery storage</text>
  <line x1="523" y1="148" x2="539" y2="148" class="ln" stroke-width="1.4"></line>
  <polygon points="520,148 525,144.5 525,151.5" class="head"></polygon>
  <polygon points="542,148 537,144.5 537,151.5" class="head"></polygon>
  <text x="546" y="152" class="t-sm">flexible demand</text>

  {[150, 308, 482].map((x) => (
    <g>
      <line x1={x + 4} y1="109" x2={x + 15} y2="109" class="ln"></line>
      <polygon points={`${x + 21},109 ${x + 13},104.5 ${x + 13},113.5`} class="head"></polygon>
    </g>
  ))}

  <!-- Receding horizon: re-plan as new real-time data arrives -->
  <path d="M574 188 V204 Q574 212 566 212 H416 Q408 212 408 204 V191" class="ln-muted" stroke-width="1.4"></path>
  <polygon points="408,186 403.5,194 412.5,194" class="head-muted"></polygon>
  <text x="491" y="204" class="t-xs t-muted" text-anchor="middle">re-plan each step (MPC)</text>

  <!-- Headline result -->
  <rect x="0" y="230" width="640" height="34" rx="8" class="w-orange"></rect>
  <circle cx="18" cy="247" r="4" class="f-orange"></circle>
  <text x="30" y="251.5" class="t-sm"><tspan class="t-b">PJM data:</tspan> a modest carbon price cuts emissions 22.5% for a 1.7% cost increase</text>
</svg>
