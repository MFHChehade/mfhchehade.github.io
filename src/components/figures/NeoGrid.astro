---
// NEO-Grid (HICSS 2026), redrawn from the framework figure: the physical
// feeder's volt-var loop and its neural twin, a ReLU power-flow surrogate
// closed through a learned volt-var rule and solved as a deep equilibrium.
// Math follows the paper: q^g = g(v; phi) (eq. 7), v* = F_phi(v*) (eq. 9).
import Tex from "./Tex.astro";

const main = [46, 80, 114, 148, 182, 214];
const busesLateral = [
  [80, 94],
  [80, 126],
  [148, 94],
  [182, 94],
];
const inverters = [
  [114, 62],
  [80, 126],
  [182, 94],
];
const curve = "M24 204 L64 204 L98 232 L142 232 L176 260 L216 260";

const tex = {
  v: String.raw`\mathbf{v}`,
  q: String.raw`\mathbf{q}`,
  qg: String.raw`\mathbf{q}^{g}`,
  vScalar: String.raw`v`,
  qScalar: String.raw`q`,
  qBar: String.raw`\bar{q}`,
  qBarNeg: String.raw`-\bar{q}`,
  surrogate: String.raw`\mathbf{v} = f^{\mathrm{NN}}(\mathbf{p}, \mathbf{q})`,
  rule: String.raw`\mathbf{q}^{g} = g(\mathbf{v};\phi)`,
  fixedPoint: String.raw`\mathbf{v}^{*} = F_{\phi}(\mathbf{v}^{*})`,
  composed: String.raw`F_{\phi} = f^{\mathrm{NN}} \circ g`,
};
---

<svg
  class="fig"
  viewBox="0 0 640 290"
  role="img"
  aria-label="NEO-Grid: in the physical feeder, power flow maps reactive power to voltages and a volt-var rule maps voltages back to reactive power. NEO-Grid learns both maps as ReLU networks and solves the closed loop directly as a deep equilibrium fixed point, trained with implicit gradients at constant memory."
>
  <text x="0" y="12" class="t-eyebrow">PHYSICAL FEEDER</text>
  <text x="252" y="12" class="t-eyebrow">NEO-GRID DIGITAL TWIN</text>

  <!-- Physical feeder and its local volt-var control -->
  <rect class="panel" x="0" y="24" width="232" height="266" rx="7"></rect>
  <line x1="23" y1="62" x2="214" y2="62" class="ln" stroke-width="1.4"></line>
  <polyline points="80,62 80,126" class="ln" stroke-width="1.4"></polyline>
  <polyline points="148,62 148,94 182,94" class="ln" stroke-width="1.4"></polyline>
  <rect x="12" y="56" width="12" height="12" rx="2" class="head"></rect>
  {main.map((x) => <circle cx={x} cy="62" r="3.4" class="dot" stroke-width="1.5"></circle>)}
  {busesLateral.map(([x, y]) => <circle cx={x} cy={y} r="3.4" class="dot" stroke-width="1.5"></circle>)}
  {inverters.map(([x, y]) => <circle cx={x} cy={y} r="5.2" class="f-orange" stroke="var(--f-panel)" stroke-width="2"></circle>)}
  <text x="12" y="44" class="t-xs t-muted">substation</text>
  <circle cx="118" cy="122" r="4" class="f-orange"></circle>
  <text x="127" y="126" class="t-xs t-muted">DER inverter</text>

  <line x1="70" y1="140" x2="70" y2="170" class="s-blue" stroke-width="2" stroke-linecap="round"></line>
  <polygon points="70,177 65.5,169 74.5,169" class="f-blue"></polygon>
  <Tex tex={tex.v} x={62} y={162} size={15} anchor="end" />
  <line x1="166" y1="177" x2="166" y2="147" class="s-orange" stroke-width="2" stroke-linecap="round"></line>
  <polygon points="166,140 161.5,148 170.5,148" class="f-orange"></polygon>
  <Tex tex={tex.q} x={175} y={162} size={15} />

  <text x="220" y="196" class="t-xs t-muted" text-anchor="end">volt-var rule</text>
  <line x1="18" y1="232" x2="220" y2="232" class="ln-faint" stroke-width="1"></line>
  <line x1="120" y1="190" x2="120" y2="274" class="ln-faint" stroke-width="1"></line>
  <line x1="116" y1="204" x2="124" y2="204" class="ln-faint" stroke-width="1"></line>
  <line x1="116" y1="260" x2="124" y2="260" class="ln-faint" stroke-width="1"></line>
  <path d={curve} class="path s-orange" stroke-width="2.2"></path>
  <Tex tex={tex.vScalar} x={222} y={250} size={14} anchor="end" />
  <Tex tex={tex.qScalar} x={112} y={200} size={14} anchor="end" />
  <Tex tex={tex.qBar} x={128} y={209} size={12} tone="muted" />
  <Tex tex={tex.qBarNeg} x={112} y={265} size={12} tone="muted" anchor="end" />

  <!-- Neural twin: the same loop, learned -->
  <rect class="panel" x="252" y="24" width="388" height="266" rx="7"></rect>

  <rect class="card" x="268" y="42" width="176" height="78" rx="9"></rect>
  <text x="356" y="62" class="t-eyebrow" text-anchor="middle">POWER-FLOW SURROGATE</text>
  <Tex tex={tex.surrogate} x={356} y={90} size={15} anchor="middle" />
  <text x="356" y="108" class="t-xs t-muted" text-anchor="middle">piecewise-linear ReLU network</text>

  <rect class="card" x="268" y="194" width="176" height="78" rx="9"></rect>
  <text x="356" y="214" class="t-eyebrow" text-anchor="middle">LEARNED VOLT-VAR RULE</text>
  <Tex tex={tex.rule} x={356} y={242} size={15} anchor="middle" />
  <text x="356" y="260" class="t-xs t-muted" text-anchor="middle">ReLU form, learned parameters</text>

  <line x1="318" y1="124" x2="318" y2="182" class="s-blue" stroke-width="2" stroke-linecap="round"></line>
  <polygon points="318,189 313.5,181 322.5,181" class="f-blue"></polygon>
  <Tex tex={tex.v} x={309} y={161} size={15} anchor="end" />
  <line x1="394" y1="190" x2="394" y2="131" class="s-orange" stroke-width="2" stroke-linecap="round"></line>
  <polygon points="394,124 389.5,132 398.5,132" class="f-orange"></polygon>
  <Tex tex={tex.qg} x={403} y={161} size={15} />

  <!-- The loop is solved as one equilibrium -->
  <polyline points="448,81 456,81 456,233 448,233" class="ln-muted" stroke-width="1.3"></polyline>
  <line x1="456" y1="157" x2="468" y2="157" class="ln"></line>
  <polygon points="474,157 466,152.5 466,161.5" class="head"></polygon>

  <rect class="card" x="478" y="42" width="148" height="230" rx="9"></rect>
  <text x="492" y="62" class="t-eyebrow">DEQ SOLVER</text>
  <text x="492" y="84" class="t-b t-sm">Fixed point of the loop</text>
  <Tex tex={tex.fixedPoint} x={492} y={115} size={16} />
  <Tex tex={tex.composed} x={492} y={140} size={13} tone="text" />
  <line x1="492" y1="156" x2="612" y2="156" class="grid"></line>
  <path d="M493 176 l4 4 l8 -9" class="ln s-green" stroke-width="2"></path>
  <text x="512" y="181" class="t-sm">implicit gradients</text>
  <text x="512" y="197" class="t-xs t-muted">no unrolling</text>
  <path d="M493 220 l4 4 l8 -9" class="ln s-green" stroke-width="2"></path>
  <text x="512" y="225" class="t-sm">constant memory</text>
  <text x="512" y="241" class="t-xs t-muted">footprint</text>
</svg>
