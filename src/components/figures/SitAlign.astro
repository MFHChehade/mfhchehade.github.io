---
// SITAlign (ICML 2025), Figure 1 redrawn from the values printed on the
// paper's bars: share of responses GPT-4 judges harmless, per reward bin.
const bins = [
  { label: "[−36, −30)", value: 5.26 },
  { label: "[−30, −24)", value: 6.26 },
  { label: "[−24, −18)", value: 57.89 },
  { label: "[−18, −12)", value: 68.42 },
  { label: "[−12, −6)", value: 89.47 },
  { label: "[−6, 0)", value: 90.42 },
];
const x0 = 56;
const x1 = 420;
const top = 56;
const base = 228;
const band = (x1 - x0) / bins.length;
const barW = 24;
const scale = (base - top) / 100;
const threshold = x0 + band * 4; // reward = -12 sits between bins 4 and 5
const ticks = [0, 25, 50, 75, 100];

const bar = (i: number, v: number) => {
  const cx = x0 + band * (i + 0.5);
  const l = cx - barW / 2;
  const r = cx + barW / 2;
  const t = base - v * scale;
  return {
    cx,
    t,
    d: `M${l} ${base} V${t + 4} Q${l} ${t} ${l + 4} ${t} H${r - 4} Q${r} ${t} ${r} ${t + 4} V${base} Z`,
  };
};
---

<svg
  class="fig"
  viewBox="0 0 640 290"
  role="img"
  aria-label="SITAlign motivation: the share of responses GPT-4 judges harmless rises with the harmlessness reward and saturates near 90 percent once the reward exceeds minus 12 (89.47 and 90.42 percent in the top two bins, against 5.26 percent in the lowest), so harmlessness can be treated as a threshold while helpfulness is maximized."
>
  <text x="0" y="12" class="t-eyebrow">HARMLESSNESS SATURATES PAST A THRESHOLD</text>
  <text x="0" y="38" class="t-sm t-muted">% of responses judged harmless (GPT-4)</text>

  {ticks.map((t) => (
    <g>
      <line x1={x0} x2={x1} y1={base - t * scale} y2={base - t * scale} class="grid"></line>
      <text x={x0 - 8} y={base - t * scale + 4} class="t-xs t-muted t-num" text-anchor="end">{t === 100 ? "100%" : t}</text>
    </g>
  ))}
  <line x1={x0} x2={x1} y1={base} y2={base} class="rule"></line>

  {bins.map((b, i) => {
    const m = bar(i, b.value);
    const above = i >= 4;
    return (
      <g>
        <path d={m.d} class={above ? "f-orange" : "f-gray"}>
          <title>{`Reward ${b.label}: ${b.value.toFixed(2)}% harmless`}</title>
        </path>
        <text x={m.cx} y={base + 17} class="t-xs t-muted t-num" text-anchor="middle">{b.label}</text>
        {above && (
          <text x={m.cx} y={m.t - 7} class="t-sm t-b t-num" text-anchor="middle">{b.value.toFixed(1)}%</text>
        )}
      </g>
    );
  })}

  <line x1={threshold} x2={threshold} y1={top - 10} y2={base} class="s-orange" stroke-width="1.4"></line>
  <text x={threshold - 6} y={top - 2} class="t-sm" text-anchor="end">threshold <tspan class="math" font-size="14">τ</tspan> = −12</text>
  <text x={(x0 + x1) / 2} y={base + 40} class="t-sm t-muted" text-anchor="middle">harmlessness reward score</text>

  <!-- The satisficing objective this motivates -->
  <rect class="card" x="446" y="40" width="194" height="196" rx="9"></rect>
  <text x="462" y="64" class="t-eyebrow">SATISFICING ALIGNMENT</text>
  <text x="462" y="96" class="t-sm t-muted">maximize</text>
  <text x="462" y="115" class="t-b">helpfulness</text>
  <text x="462" y="141" class="t-sm t-muted">subject to</text>
  <text x="462" y="160" class="t-b">harmlessness ≥ <tspan class="math" font-size="15">τ</tspan></text>
  <line x1="462" y1="176" x2="624" y2="176" class="grid"></line>
  <text x="462" y="196" class="t-xs t-muted">Past τ, extra harmlessness reward</text>
  <text x="462" y="211" class="t-xs t-muted">buys little, so it is enforced as a</text>
  <text x="462" y="226" class="t-xs t-muted">threshold at inference time.</text>
</svg>
