---
// SITAlign (ICML 2025), Figure 1 of the paper as a plain bar chart: share of
// responses GPT-4 judges harmless in each harmlessness-reward bin. Values are
// the ones printed on the paper's bars.
const bins = [
  { label: "[−36, −30)", value: 5.26 },
  { label: "[−30, −24)", value: 6.26 },
  { label: "[−24, −18)", value: 57.89 },
  { label: "[−18, −12)", value: 68.42 },
  { label: "[−12, −6)", value: 89.47 },
  { label: "[−6, 0)", value: 90.42 },
];
const x0 = 64;
const x1 = 632;
const top = 20;
const base = 236;
const band = (x1 - x0) / bins.length;
const barW = band * 0.6;
const scale = (base - top) / 100;
const ticks = [0, 20, 40, 60, 80, 100];
---

<svg
  class="fig"
  viewBox="0 0 640 296"
  role="img"
  aria-label="Bar chart from the SITAlign paper: percentage of responses GPT-4 judges harmless by harmlessness reward score. 5.26% for rewards in [-36, -30), 6.26% in [-30, -24), 57.89% in [-24, -18), 68.42% in [-18, -12), 89.47% in [-12, -6), and 90.42% in [-6, 0)."
>
  {ticks.map((t) => (
    <g>
      <line x1={x0} x2={x1} y1={base - t * scale} y2={base - t * scale} class="grid"></line>
      <text x={x0 - 8} y={base - t * scale + 4} class="t-sm t-muted t-num" text-anchor="end">{t}</text>
    </g>
  ))}
  <line x1={x0} x2={x1} y1={base} y2={base} class="ln" stroke-width="1"></line>
  <line x1={x0} x2={x0} y1={top} y2={base} class="ln" stroke-width="1"></line>

  {bins.map((b, i) => {
    const cx = x0 + band * (i + 0.5);
    const h = b.value * scale;
    return (
      <g>
        <rect x={cx - barW / 2} y={base - h} width={barW} height={h} class="f-blue">
          <title>{`Reward ${b.label}: ${b.value.toFixed(2)}% harmless`}</title>
        </rect>
        <text x={cx} y={base - h - 6} class="t-sm t-num" text-anchor="middle">{b.value.toFixed(2)}%</text>
        <text x={cx} y={base + 18} class="t-sm t-muted t-num" text-anchor="middle">{b.label}</text>
      </g>
    );
  })}

  <text x={(x0 + x1) / 2} y={base + 46} class="t-sm" text-anchor="middle">Reward score</text>
  <text x="0" y="0" class="t-sm" text-anchor="middle" transform={`translate(16 ${(top + base) / 2}) rotate(-90)`}>% harmless (GPT-4 judge)</text>
</svg>
