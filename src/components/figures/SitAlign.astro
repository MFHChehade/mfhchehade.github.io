---
// SITAlign (ICML 2025), Figure 2 (Evaluation 1) of the paper as one scatter:
// GPT-4 win-tie rates against the base model on PKU-SafeRLHF, helpfulness on
// x and harmlessness on y, with the 50% harmlessness threshold. Values were
// read off the paper's bar images (calibrated to their gridlines; accurate to
// about 0.05 points).
const methods = [
  { name: "helpfulness only", help: 65.3, harm: 46.6, label: { dx: 13, dy: 5, anchor: "start" } },
  { name: "harmlessness only", help: 45.3, harm: 70.3, label: { dx: -4, dy: -14, anchor: "start" } },
  { name: "MOD", help: 46.3, harm: 68.3, label: { dx: 13, dy: 5, anchor: "start" } },
];
const ours = { name: "SITAlign", help: 68.3, harm: 65.3 };
const threshold = 50;

const x0 = 80;
const x1 = 612;
const y0 = 296; // bottom of the plot area
const y1 = 16; // top
const lo = 40;
const hi = 75;
const sx = (v: number) => x0 + ((v - lo) / (hi - lo)) * (x1 - x0);
const sy = (v: number) => y0 - ((v - lo) / (hi - lo)) * (y0 - y1);
const ticks = [40, 45, 50, 55, 60, 65, 70, 75];
---

<svg
  class="fig"
  viewBox="0 0 640 356"
  role="img"
  aria-label="Scatter plot from the SITAlign paper: GPT-4 win-tie rates against the base model on PKU-SafeRLHF. Decoding for helpfulness only reaches 65.3% helpfulness but 46.6% harmlessness, below the 50% threshold. Decoding for harmlessness only reaches 45.3% and 70.3%, and MOD 46.3% and 68.3%. SITAlign reaches 68.3% helpfulness and 65.3% harmlessness."
>
  <!-- region that fails the harmlessness threshold -->
  <rect x={x0} y={sy(threshold)} width={x1 - x0} height={y0 - sy(threshold)} class="panel"></rect>

  {ticks.map((t) => (
    <g>
      <line x1={x0} x2={x1} y1={sy(t)} y2={sy(t)} class="grid"></line>
      <line x1={sx(t)} x2={sx(t)} y1={y1} y2={y0} class="grid"></line>
      <text x={x0 - 10} y={sy(t) + 4.5} class="t-muted t-num" text-anchor="end">{t}</text>
      <text x={sx(t)} y={y0 + 21} class="t-muted t-num" text-anchor="middle">{t}</text>
    </g>
  ))}
  <line x1={x0} x2={x1} y1={y0} y2={y0} class="ln" stroke-width="1"></line>
  <line x1={x0} x2={x0} y1={y1} y2={y0} class="ln" stroke-width="1"></line>

  <line x1={x0} x2={x1} y1={sy(threshold)} y2={sy(threshold)} class="ln-muted dash" stroke-width="1.5"></line>
  <text x={x1 - 6} y={sy(threshold) - 8} class="t-muted" text-anchor="end">harmlessness threshold</text>

  {methods.map((m) => (
    <g>
      <circle cx={sx(m.help)} cy={sy(m.harm)} r="6.5" class="f-gray" stroke="var(--f-bg)" stroke-width="2">
        <title>{`${m.name}: ${m.help.toFixed(1)}% helpfulness, ${m.harm.toFixed(1)}% harmlessness`}</title>
      </circle>
      <text x={sx(m.help) + m.label.dx} y={sy(m.harm) + m.label.dy} class="t-md" text-anchor={m.label.anchor}>{m.name}</text>
    </g>
  ))}

  <circle cx={sx(ours.help)} cy={sy(ours.harm)} r="8" class="f-orange" stroke="var(--f-bg)" stroke-width="2">
    <title>{`${ours.name}: ${ours.help.toFixed(1)}% helpfulness, ${ours.harm.toFixed(1)}% harmlessness`}</title>
  </circle>
  <text x={sx(ours.help) + 15} y={sy(ours.harm) + 5.5} class="t-lg t-b">{ours.name}</text>

  <text x={(x0 + x1) / 2} y={y0 + 50} class="t-md" text-anchor="middle">Helpfulness win-tie rate (%)</text>
  <text x="0" y="0" class="t-md" text-anchor="middle" transform={`translate(22 ${(y0 + y1) / 2}) rotate(-90)`}>Harmlessness win-tie rate (%)</text>
</svg>
