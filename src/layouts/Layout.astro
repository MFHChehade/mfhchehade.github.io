---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: "website" | "article" | "profile";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Mohamad Chehade is a Ph.D. student at The University of Texas at Austin working on risk-aware machine learning, data-driven reliability, reinforcement learning, LLMs, and power systems applications.",
  ogImage = "/og-image.png",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

import { UMAMI_WEBSITE_ID, UMAMI_SCRIPT_URL, UMAMI_DOMAINS } from "../config/analytics";
import "../styles/figures.css";

// Analytics only ship in a production build, and only once an ID is set.
const enableAnalytics = import.meta.env.PROD && UMAMI_WEBSITE_ID !== "";

const siteOrigin = Astro.site?.origin ?? "https://mohamadchehade.com";
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageURL = new URL(ogImage, siteOrigin).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/research", label: "Research" },
  { href: "/publications", label: "Publications" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mohamad Chehade",
  givenName: "Mohamad",
  familyName: "Chehade",
  alternateName: "Mohamad Fares El Hajj Chehade",
  jobTitle: "Ph.D. Student",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "The University of Texas at Austin",
    department: "Electrical and Computer Engineering",
  },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "American University of Beirut",
    },
  ],
  url: siteOrigin,
  email: "mailto:chehade@utexas.edu",
  sameAs: [
    "https://scholar.google.com/citations?user=cVUnhukAAAAJ&hl=en",
    "https://github.com/MFHChehade",
    "https://lb.linkedin.com/in/mfhchehade",
  ],
  knowsAbout: [
    "Machine Learning",
    "Reinforcement Learning",
    "Large Language Models",
    "Neural Network Verification",
    "Power Systems",
    "Risk-aware Learning",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mohamad Chehade" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:site_name" content="Mohamad Chehade" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content="Mohamad Chehade — Ph.D. student in Electrical and Computer Engineering at The University of Texas at Austin." />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Mohamad Chehade — Ph.D. student in Electrical and Computer Engineering at The University of Texas at Austin." />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>

    {
      enableAnalytics && (
        <script
          is:inline
          defer
          src={UMAMI_SCRIPT_URL}
          data-website-id={UMAMI_WEBSITE_ID}
          data-domains={UMAMI_DOMAINS}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="bg-aura" aria-hidden="true"></div>

    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="site-name" aria-label="Mohamad Chehade home">
          <span class="site-mark">MC</span>
          <span class="site-name-text">Mohamad Chehade</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[{ active: isActive(link.href) }]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
          <a class="nav-cv" href="/CV_Mohamad.pdf" target="_blank" rel="noopener noreferrer">CV ↗</a>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="site-mark small">MC</span>
          <div>
            <strong>Mohamad Chehade</strong>
            <p>Reliable learning systems for decisions under uncertainty.</p>
          </div>
        </div>
        <div class="footer-links">
          <a href="https://scholar.google.com/citations?user=cVUnhukAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Scholar</a>
          <a href="https://github.com/MFHChehade" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://lb.linkedin.com/in/mfhchehade" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="mailto:chehade@utexas.edu">Email</a>
        </div>
        <p class="footer-copy">&copy; {new Date().getFullYear()} Mohamad Chehade</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const btn = document.getElementById("theme-toggle");
        if (btn) {
          btn.addEventListener("click", function () {
            const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
            document.documentElement.dataset.theme = next;
            try { localStorage.setItem("theme", next); } catch (e) {}
          });
        }
        // Scroll reveal
        const els = document.querySelectorAll("[data-reveal]");
        if ("IntersectionObserver" in window && els.length) {
          const io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
          els.forEach(function (el) { io.observe(el); });
        } else {
          els.forEach(function (el) { el.classList.add("is-visible"); });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Palette: UT burnt orange (#bf5700) as the single accent, a deep ink blue
     for links, plain white paper with neutral greys. Dark mode is its own set
     of steps, not an inversion. */
  :root {
    color-scheme: light;
    --burnt: #bf5700;
    --burnt-bright: #d8690f;
    --burnt-dark: #9c4700;
    --accent-soft: rgba(191, 87, 0, 0.07);
    --accent-line: rgba(191, 87, 0, 0.24);

    --ink: #16181c;
    --charcoal: #2b2f36;
    --muted: #5b626c;
    --bg: #ffffff;
    --bg-2: #f6f7f8;
    --paper: #ffffff;
    --paper-2: #f6f7f8;
    --line: #e5e7ea;
    --line-strong: #cfd3d8;

    --blue: #1b5e8c;
    --blue-soft: rgba(27, 94, 140, 0.07);
    --blue-line: rgba(27, 94, 140, 0.2);
    --green: #1f6f55;
    --green-soft: rgba(31, 111, 85, 0.08);
    --on-accent: #ffffff;

    /* Aliases older page styles still reference. */
    --soft: var(--paper-2);
    --warm: var(--accent-soft);
    --wash: var(--blue-soft);

    --shadow-soft: 0 1px 2px rgba(20, 23, 28, 0.04), 0 4px 14px rgba(20, 23, 28, 0.04);
    --shadow: 0 2px 6px rgba(20, 23, 28, 0.05), 0 16px 40px rgba(20, 23, 28, 0.08);
    --shadow-lift: 0 4px 10px rgba(20, 23, 28, 0.07), 0 22px 50px rgba(191, 87, 0, 0.1);

    --radius: 12px;
    --radius-sm: 8px;
    --max-width: 1120px;

    /* One plain family for everything, as most academic sites do; headings
       are the same face in semibold. */
    --sans: "Source Sans 3", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --burnt: #f0883e;
    --burnt-bright: #ff9b55;
    --burnt-dark: #d9722a;
    --accent-soft: rgba(240, 136, 62, 0.1);
    --accent-line: rgba(240, 136, 62, 0.3);

    --ink: #e8eaed;
    --charcoal: #d1d5da;
    --muted: #9aa1ab;
    --bg: #111317;
    --bg-2: #16191e;
    --paper: #191c21;
    --paper-2: #1f2329;
    --line: #2b3037;
    --line-strong: #3a4049;

    --blue: #82b9e4;
    --blue-soft: rgba(130, 185, 228, 0.1);
    --blue-line: rgba(130, 185, 228, 0.26);
    --green: #6cc5a3;
    --green-soft: rgba(108, 197, 163, 0.1);
    --on-accent: #1a1208;

    --shadow-soft: 0 1px 2px rgba(0, 0, 0, 0.3), 0 4px 14px rgba(0, 0, 0, 0.25);
    --shadow: 0 2px 6px rgba(0, 0, 0, 0.35), 0 16px 40px rgba(0, 0, 0, 0.45);
    --shadow-lift: 0 4px 10px rgba(0, 0, 0, 0.4), 0 22px 50px rgba(240, 136, 62, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  html {
    color: var(--ink);
    background: var(--bg);
    font-family: var(--sans);
    font-size: 16px;
    scroll-behavior: smooth;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    position: relative;
    min-height: 100vh;
    margin: 0;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    overflow-x: hidden;
  }

  .bg-aura {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--bg);
  }

  img {
    max-width: 100%;
    display: block;
  }

  main {
    width: min(100% - 2rem, var(--max-width));
    flex: 1;
    margin: 0 auto;
    padding: 0 0 4rem;
  }

  ::selection {
    background: var(--burnt);
    color: var(--on-accent);
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.45rem 0.65rem;
    color: var(--bg);
    background: var(--charcoal);
    border-radius: 6px;
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid transparent;
    backdrop-filter: saturate(160%) blur(16px);
    transition: border-color 200ms ease, background 200ms ease;
  }

  .site-header-inner {
    width: min(100% - 2rem, var(--max-width));
    min-height: 64px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-name {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-mark {
    width: 2.4rem;
    height: 2.4rem;
    display: inline-grid;
    place-items: center;
    color: #fff;
    background: var(--burnt);
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  :root[data-theme="dark"] .site-mark {
    color: #1a1208;
  }

  .site-mark.small {
    width: 2rem;
    height: 2rem;
    font-size: 0.88rem;
  }

  .site-name:hover {
    color: var(--burnt);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.2rem;
    font-size: 0.94rem;
    font-weight: 500;
  }

  .site-nav a {
    position: relative;
    min-height: 2.3rem;
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    text-decoration: none;
    padding: 0.35rem 0.78rem;
    border-radius: 8px;
    transition: color 160ms ease, background 160ms ease;
  }

  .site-nav a::after {
    content: "";
    position: absolute;
    left: 0.78rem;
    right: 0.78rem;
    bottom: 0.28rem;
    height: 2px;
    background: var(--burnt);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }

  .site-nav a:hover,
  .site-nav a.active {
    color: var(--ink);
  }

  .site-nav a:hover::after,
  .site-nav a.active::after {
    transform: scaleX(1);
  }

  .nav-cv {
    color: var(--burnt) !important;
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
  }

  .nav-cv::after {
    display: none;
  }

  .nav-cv:hover {
    background: var(--burnt) !important;
    color: var(--on-accent) !important;
  }

  .theme-toggle {
    width: 2.3rem;
    height: 2.3rem;
    margin-left: 0.35rem;
    display: inline-grid;
    place-items: center;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 9px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .theme-toggle:hover {
    color: var(--burnt);
    border-color: var(--accent-line);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }

  .icon-moon { display: none; }
  :root[data-theme="dark"] .icon-sun { display: none; }
  :root[data-theme="dark"] .icon-moon { display: block; }

  /* Footer */
  footer {
    color: var(--muted);
    font-size: 0.9rem;
    padding: 2.4rem 1rem;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    width: min(100% - 2rem, var(--max-width));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.4rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .footer-brand strong {
    color: var(--ink);
    font-size: 0.98rem;
  }

  .footer-brand p {
    margin: 0.1rem 0 0;
    font-size: 0.85rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: 7px;
    transition: color 160ms ease, background 160ms ease;
  }

  .footer-links a:hover {
    color: var(--burnt);
    background: var(--accent-soft);
  }

  .footer-copy {
    margin: 0;
    font-size: 0.82rem;
  }

  /* Typography */
  h1, h2, h3 {
    color: var(--ink);
    margin: 0;
    font-weight: 600;
    line-height: 1.2;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(1.9rem, 3vw, 2.3rem);
  }

  h2 {
    font-size: clamp(1.3rem, 2vw, 1.5rem);
    margin-bottom: 1rem;
  }

  h3 {
    font-size: 1.08rem;
  }

  p {
    margin: 0 0 0.9rem;
  }

  a {
    color: var(--blue);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    transition: color 160ms ease;
  }

  a:hover {
    color: var(--burnt);
  }

  ul, ol {
    margin: 0.4rem 0 0.8rem 1.2rem;
    padding: 0;
  }

  li {
    margin: 0.32rem 0;
  }

  .plain-list {
    list-style: none;
    margin-left: 0;
  }

  :focus-visible {
    outline: 2px solid var(--burnt);
    outline-offset: 3px;
  }

  /* Reveal animation */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 620ms cubic-bezier(0.22, 1, 0.36, 1), transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
    [data-reveal] { opacity: 1; transform: none; }
  }

  .page-heading {
    max-width: 860px;
    padding: 3.4rem 0 1.6rem;
    margin-bottom: 0.75rem;
  }

  .page-heading h1 {
    margin-bottom: 0.8rem;
  }

  .page-heading p,
  .lead {
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.6;
  }

  .section {
    margin-top: 2.9rem;
  }

  .section:first-child {
    margin-top: 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .section-heading h2 {
    margin-bottom: 0;
  }

  .section-heading > p,
  .section-heading > a {
    color: var(--muted);
    margin: 0;
    max-width: 520px;
    font-size: 0.96rem;
  }

  .section-heading > a {
    color: var(--burnt);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .section-heading > a:hover {
    text-decoration: underline;
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .button {
    min-height: 2.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: var(--on-accent);
    background: var(--burnt);
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0.55rem 1.15rem;
    font-weight: 600;
    font-size: 0.96rem;
    text-decoration: none;
    box-shadow: 0 6px 18px var(--accent-line);
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .button:hover {
    color: var(--on-accent);
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px var(--accent-line);
  }

  .button.secondary {
    color: var(--ink);
    background: var(--paper);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-soft);
  }

  .button.secondary:hover {
    color: var(--burnt);
    border-color: var(--accent-line);
    background: var(--paper-2);
  }

  .modern-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.05rem;
  }

  .surface {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .publication-list,
  .news-list {
    display: grid;
    gap: 0;
  }

  .publication-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 1.3rem 1.1rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .publication-entry + .publication-entry {
    margin-top: 0.2rem;
  }

  .publication-entry:hover {
